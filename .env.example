APP_NAME=EduNexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=edunexus_dev
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# EduNexus client. The root .env is the development client; real clients
# live in deployments/<code>/ (see edunexus:client:create) and are selected
# with EDUNEXUS_CLIENT=<code>.
EDUNEXUS_CLIENT_CODE=dev
EDUNEXUS_ORG_NAME="EduNexus Development"
EDUNEXUS_INSTITUTION_TYPE=school
RECEIPT_PREFIX=RCPT

# How guardians hear about absences: log (sends nothing) or whatsapp.
EDUNEXUS_GUARDIAN_NOTIFIER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ABSENCE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
EDUNEXUS_MODULES_ENABLE=
EDUNEXUS_MODULES_DISABLE=

# Super Admin for the development client, created by php artisan db:seed.
# Never copied into clients made by edunexus:client:create.
EDUNEXUS_SUPER_ADMIN_NAME="Super Admin"
EDUNEXUS_SUPER_ADMIN_EMAIL=
EDUNEXUS_SUPER_ADMIN_PASSWORD=

# Privileged MySQL account used only by edunexus:client:* to create and drop
# client databases and users. Never used by the running app.
DB_PROVISION_USERNAME=root
DB_PROVISION_PASSWORD=
DB_PROVISION_USER_HOST=%
